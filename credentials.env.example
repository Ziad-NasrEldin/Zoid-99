# Zoid 99 local-only credential template
# Copy this file to credentials.env, fill the secret fields locally, and never commit that completed file.

# Google Cloud and YouTube
ZOID99_GOOGLE_CLOUD_PROJECT_NAME="Zoid 99 Production"
ZOID99_GOOGLE_CLOUD_PROJECT_ID="zoid-99-production"
ZOID99_GOOGLE_CLOUD_PROJECT_NUMBER="325794185401"
ZOID99_YOUTUBE_API_KEY="<paste the YouTube Data API key from Google Cloud Console>"
ZOID99_YOUTUBE_OAUTH_CLIENT_ID="325794185401-fin5cdgq8pn23uh07nidp0k4q6mf7lt9.apps.googleusercontent.com"
ZOID99_YOUTUBE_OAUTH_CLIENT_SECRET="<paste from the downloaded Google OAuth desktop client JSON>"
ZOID99_YOUTUBE_OAUTH_SCOPES="https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.force-ssl"

# OpenAI
ZOID99_OPENAI_PROJECT_ID="proj_ChfSJQQiNadFKwIrlQUeiqiU"
ZOID99_OPENAI_API_KEY="<paste an active OpenAI project API key>"
ZOID99_OPENAI_MODEL="gpt-5.4"

# Google Trends
ZOID99_GOOGLE_TRENDS_PROVIDER="credential-free"

# Safe reference IDs, not credentials
ZOID99_APPLE_TEAM_ID="377QC32T9T"
ZOID99_APPLE_BUNDLE_ID="com.zoid.zoid99"

# Not used by the local-only MVP
# X API credentials
# Meta or Instagram API credentials
# Apple distribution or notarization credentials
# Hosting, backend, or cloud database credentials
