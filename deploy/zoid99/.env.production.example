NODE_ENV=production
HOST=0.0.0.0
PORT=8099
LOG_LEVEL=info
SERVICE_VERSION=replace-with-release-id
PUBLIC_BASE_URL=https://zoid99.mavoid.com
COLLECTION_INTERVAL_SECONDS=900

POSTGRES_DB=zoid99
POSTGRES_USER=zoid99
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql://zoid99:replace-with-a-unique-database-password@zoid99-postgres:5432/zoid99?sslmode=require&uselibpqcompat=true

ZOID99_API_TOKEN=replace-with-a-random-32-character-minimum-token
ZOID99_OPERATOR_PASSWORD=replace-with-a-unique-operator-password
SECRETS_ENCRYPTION_KEY=replace-with-32-base64-encoded-random-bytes

ZOID99_BACKEND_BASE_URL=https://zoid99.mavoid.com
ZOID99_WEB_SERVICE_TOKEN=replace-with-the-same-value-as-ZOID99_API_TOKEN
