NODE_ENV=production
HOST=0.0.0.0
PORT=8099
LOG_LEVEL=info
SERVICE_VERSION=replace-with-git-sha
PUBLIC_BASE_URL=https://replace-with-private-service-host
COLLECTION_INTERVAL_SECONDS=900
# Optional HTTPS webhook for allowlisted startup and collection failure events.
ERROR_MONITORING_WEBHOOK_URL=https://replace-with-monitoring-provider-hook
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/zoid99?sslmode=verify-full
# Generate a random value with at least 32 characters and store it only in the host secret manager and macOS Keychain.
ZOID99_API_TOKEN=replace-in-secret-manager
# Set only during a short rotation window, then remove after every client uses the new value.
# ZOID99_API_TOKEN_PREVIOUS=replace-in-secret-manager
# Generate exactly 32 random bytes, encode them as base64, and store the value only in the host secret manager.
SECRETS_ENCRYPTION_KEY=replace-in-secret-manager
