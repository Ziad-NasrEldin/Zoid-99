{
  "name": "zoid99-backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "npm --prefix ../packages/contracts ci --ignore-scripts --workspaces=false && npm --prefix ../packages/contracts run build",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/migrate.ts",
    "config:validate": "tsx src/validate-config.ts",
    "secrets:rotate-key": "tsx src/rotate-encryption-key.ts",
    "start": "node dist/src/main.js",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@zoid99/contracts": "file:../packages/contracts",
    "fast-xml-parser": "^5.10.1",
    "fastify": "5.10.0",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
