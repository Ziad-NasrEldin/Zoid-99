{
  "name": "zoid-99-workspace",
  "private": true,
  "workspaces": ["web", "packages/*"],
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6",
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "scripts": {
    "postinstall": "npm run build --workspace @zoid99/contracts",
    "web:audit": "npm audit --omit=dev",
    "agentation:server": "npm --workspace web run agentation:server",
    "web:dev": "npm --workspace web run dev",
    "web:build": "npm --workspace web run build",
    "web:lint": "npm --workspace web run lint",
    "web:typecheck": "npm --workspace web run typecheck",
    "web:test": "npm --workspace web run test",
    "web:test:e2e": "npm --workspace web run test:e2e"
  }
}
